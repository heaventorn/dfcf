# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ===== 运行时产物 =====
output/

# ===== 登录凭据（不建议入库，避免账号被冒用风险） =====
cookies.json

# ===== 本地临时 / 调试文件 =====
# Edge --app 独立窗口模式用的专用 profile（由 main.py 创建）
.edge_profile/
_probe_em.py
_probe_tx.py
*.bak
# 本地密钥文件（含二级密码哈希，绝不上传公开仓库）
pwd.key

# LLM API Key
.env
# DeepSeek / 大模型 Key（strategy.json 的 llm.key_file 默认读这个文件名）
secrets.json


# 工具机 / 编辑器
.reasonix/
.vscode/
# 误生成的空文件
0
0.5
# 误生成的空文件（本次会话产生，锚定到仓库根）
/1000
/'
# 与本项目无关的本地实验目录（3D 个人网站模板 / Playwright 截图验证工具）
_site_src/
_site_tools/
reasonix.toml
# 本地实验遗留的大体积素材（本项目代码不引用；Natural Earth 原始 geojson + 字体）
assets/fonts/
assets/geo/
# 预览页(由 events.py 生成,不入库)
events_live.html
# 回测/自检临时脚本与产物(本地调试用,不入库)
_bt_tmp/
# 研究期脚本目录(自检 / 压测 / 季节性 / 追踪器自检)：整个目录不入库
_scen/
# ===== 本地数据目录 =====
# 持仓 / 自选 / 策略蓝图 / cookies / pwd.key / secrets.json 全在 data/ 里，整目录不入库。
# 路径常量集中在 config.py；新机器克隆下来后，data/ 会按 data_templates/ 自动生成。
/data/
# 兼容旧布局：这几个文件若还留在仓库根目录，同样不许入库（锚定根目录，别误伤别的目录）
/positions.json
/watchlist.json
/strategy.json

# ===== 上帝视角（内嵌在 godseye/ 的 God's Eye View）=====
# 依赖目录几个 G，绝不入库；源码本体保留在仓库里。
godseye/node_modules/
godseye/.vite/
godseye/dist/
# 上游自带的功能演示 GIF（67 MB）：演示的是本项目已经删掉的语音 / 座舱 / 特效那些功能，
# 留着只会让仓库和每次克隆都变重。docs 里引用这些动图的地方会显示不出来，属预期。
godseye/docs/media/
